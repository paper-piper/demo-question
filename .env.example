# Google Sheets service-account credentials.
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
# The "Results" and "Corkboard" tabs are created automatically on first write.
# The "Questions" tab (quiz content) is created by hand — see
# docs/google-sheets-setup.md.

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Password for the secret /admin/rebuild?key=... link that lets editors
# publish quiz-question changes from the sheet. See docs/google-sheets-setup.md.
REBUILD_SECRET=

# Netlify build hook URL (Site configuration -> Build & deploy -> Build hooks).
# /admin/rebuild POSTs to this to trigger a redeploy.
NETLIFY_BUILD_HOOK_URL=
